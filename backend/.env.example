################################################################################
# Wear Impressive — Backend .env.example
# Copy to .env and fill in real secrets. Never commit .env.
################################################################################

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME="Wear Impressive"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://api.wearimpressive.com
APP_DOMAIN=wearimpressive.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ────────────────────────────────────────────────────────────────
# Dev: sqlite. Prod: mysql
# DB_CONNECTION=sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wear_impressive
DB_USERNAME=
DB_PASSWORD=

# ─── Sessions / Cache / Queue ────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.wearimpressive.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@wearimpressive.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Sanctum ─────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=wearimpressive.com,www.wearimpressive.com

# ─── Search ──────────────────────────────────────────────────────────────────
SCOUT_DRIVER=collection

# ─── Payment Gateways (BD) ───────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=true

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_IS_SANDBOX=true

# REQUIRED IN PRODUCTION — random 32-char string
PAYMENTS_WEBHOOK_SECRET=

# ─── Courier Partners (BD) ───────────────────────────────────────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_SECRET_TOKEN=
PATHAO_IS_SANDBOX=true

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

REDX_API_TOKEN=

COURIERS_WEBHOOK_SECRET=
