################################################################################
# eTommerce Backend — .env.example
# Copy to .env and fill in real secrets. Never commit .env.
################################################################################

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME="eTommerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000
APP_DOMAIN=etommerce.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
# Dev: sqlite. Prod: mysql 8.0
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=etommerce
# DB_USERNAME=etommerce
# DB_PASSWORD=

# ─── Sessions / Cache / Queue ────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Prod: use s3 disk
# FILESYSTEM_DISK=s3

QUEUE_CONNECTION=database
# Prod: redis recommended
# QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────────────────────
# Dev: log. Prod: smtp / mailgun / ses
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@etommerce.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS S3 (for production uploads) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Sanctum ─────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,etommerce.com

# ─── Search (Laravel Scout) ──────────────────────────────────────────────────
# Dev/test: collection (no external service needed)
SCOUT_DRIVER=collection
# Prod: meilisearch
# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

# ─── Payment Gateways (BD) ───────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=true

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_IS_SANDBOX=true

# Optional shared secret for payment webhooks
# ⚠️  REQUIRED IN PRODUCTION — set to a random 32-char string or anyone can
#    forge webhook calls and mark orders as paid.
PAYMENTS_WEBHOOK_SECRET=

# ─── Courier Partners (BD) ───────────────────────────────────────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_SECRET_TOKEN=
PATHAO_IS_SANDBOX=true

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

REDX_API_TOKEN=

# Shared courier webhook secret (override per-store via DeliveryPartner.settings.webhook_secret)
COURIERS_WEBHOOK_SECRET=

# ─── Frontend (Vite — kept for Laravel assets, not used by Next.js) ──────────
VITE_APP_NAME="${APP_NAME}"
